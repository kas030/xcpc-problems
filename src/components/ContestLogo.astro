---
import { Image } from 'astro:assets';
import ccpc from '../assets/ccpc.png';
import icpc from '../assets/icpc.png';
import type { Contest } from '../lib/schema';

interface Props { series: Contest['series'] }
const { series } = Astro.props;
const logo = series === 'CCPC' ? ccpc : icpc;
---
<Image class="contest-logo" src={logo} alt="" width={104} densities={[1]} draggable="false" />

<style>
  .contest-logo { display: block; width: 52px; height: 52px; object-fit: contain; flex-shrink: 0; -webkit-user-select: none; user-select: none; }
</style>
