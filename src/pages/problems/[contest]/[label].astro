---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { catalog } from '../../../lib/catalog';
import { base, href } from '../../../lib/urls';
import { difficultyLabels } from '../../../lib/schema';
import { statementPdfs, qojStatementPdfs } from '../../../lib/statement-pdfs';
import { problemPdfPath } from '../../../lib/statement-sources';
export function getStaticPaths() {
  return catalog.problems.map(problem => ({ params: { contest: problem.contestId, label: problem.label }, props: { problem, contest: catalog.contests.find(c => c.id === problem.contestId)! } }));
}
const { problem, contest } = Astro.props;
// Official Chinese statements always retain their original presentation.
const officialChinese = problem.statement?.language === 'zh' && problem.statement.provenance === 'official';
const entry = problem.markdown ? (await getCollection('statements')).find(e => e.data.problemId === problem.id && (!officialChinese || e.data.status === 'official')) : undefined;
const rendered = entry ? await render(entry) : undefined;
const Content = rendered?.Content;
const statement = problem.statement;
const isBooklet = statement?.format === 'pdf' && statement.scope !== 'problem';
const pdfFragment = `#page=${statement?.page ?? 1}&view=FitH`;
const sourceUrl = statement?.format === 'pdf' ? `${statement.url}${pdfFragment}` : statement?.url;
const localPdf = statement?.format === 'pdf' ? statementPdfs.get(statement.url) : undefined;
const bookletUrl = localPdf ? `${localPdf}${pdfFragment}` : sourceUrl;
const singlePdf = problemPdfPath(problem.id, statement);
const readerUrl = singlePdf ? `${base}/${singlePdf}#view=FitH` : bookletUrl;
const translated = !!Content && entry?.data.language === 'zh' && entry.data.status !== 'official' && statement?.language === 'en' && statement.provenance === 'official';
const originalEntry = translated && statement?.format === 'html' ? (await getCollection('originals')).find(e => e.data.problemId === problem.id && e.data.source === statement.url) : undefined;
const originalRendered = originalEntry ? await render(originalEntry) : undefined;
const OriginalContent = originalRendered?.Content;
const qojChinese = entry?.data.status === 'qoj';
const qojPdf = qojChinese && entry.data.format === 'pdf' ? qojStatementPdfs.get(problem.qojId) : undefined;
if (entry?.data.format === 'pdf' && !qojPdf) throw new Error(`QOJ 中文 PDF 缺失：${problem.id}`);
---
<Layout title={`${problem.label}. ${problem.title} · ${contest.shortName}`}>
  <nav class="breadcrumb" aria-label="面包屑"><a href={href()}>题单</a><span>/</span><a href={href(`contests/${contest.id}`)}>{contest.shortName}</a><span>/</span><span>Problem {problem.label}</span></nav>
  <header class="detail-head">
    <div class="detail-heading"><h1><span class="detail-label">{problem.label}.</span>{problem.title}</h1><div class="detail-meta"><a class="contest-tag" data-series={contest.series} href={href(`contests/${contest.id}`)}>{contest.shortName}</a><span class={`difficulty-badge ${problem.difficulty}`}>{difficultyLabels[problem.difficulty]}</span><a class="qoj-link" href={`https://qoj.ac/problem/${problem.qojId}`} target="_blank" rel="noopener noreferrer" title="在 QOJ 打开题目">QOJ #{problem.qojId}</a>{problem.interactive && <span>交互题</span>}</div></div>
    <div class="detail-actions">
      <button class="button button-primary progress-button" data-progress-id={problem.id} aria-pressed="false"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg><span data-progress-label>标记为已完成</span></button>
      <p class="detail-note" data-progress-note role="status" hidden></p>
    </div>
  </header>
  <div class="detail-grid">
    <section>
      {(Content || localPdf) && <div class="reading-card" data-translatable={translated || undefined}>
        {(translated || statement) && <div class="reading-toolbar">
          {translated && <fieldset class="statement-switch">
            <legend class="sr-only">题面语言</legend>
            <label><input type="radio" name="statement-language" value="zh" checked /><span>{qojChinese ? 'QOJ 中文' : '中文翻译'}</span></label>
            <label><input type="radio" name="statement-language" value="en" /><span>官方英文</span></label>
          </fieldset>}
          {statement && <a class="booklet-link" href={bookletUrl} target="_blank" rel="noopener noreferrer" title={isBooklet ? '在新标签页打开完整题册' : '在新标签页打开原始题面'}><span>{isBooklet ? '完整题册' : '原始题面'}</span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg></a>}
        </div>}
        {qojPdf && <iframe data-translation class="pdf-frame" src={`${qojPdf}#view=FitH`} title={`${problem.label}. ${problem.title} QOJ 中文题面`} referrerpolicy="no-referrer" />}
        {Content ? <article class="prose statement-prose" data-translation lang={entry!.data.language === 'zh' ? 'zh-CN' : 'en'}><Content /></article> : statement?.format === 'pdf' && localPdf ? <>
          <iframe class="pdf-frame" src={readerUrl} title={`${problem.label}. ${problem.title} ${statement.language === 'zh' ? '中文' : ''}题面`} referrerpolicy="no-referrer" />
        </> : null}
        {translated && <div data-original lang="en">
          {OriginalContent ? <article class="prose statement-prose"><OriginalContent /></article> : statement?.format === 'pdf' && localPdf ? <iframe class="pdf-frame" src={readerUrl} title={`${problem.label}. ${problem.title} 官方英文题面`} referrerpolicy="no-referrer" loading="lazy" /> : <p class="statement-prose"><a class="button" href={sourceUrl} target="_blank" rel="noopener noreferrer">打开官方英文题面 ↗</a></p>}
        </div>}
      </div>}
    </section>
    <aside class="detail-sidebar">
      <section class="detail-card" id="difficulty">
        <h2>通过情况</h2>
        <div class="cohort-row"><div class="cohort-label"><span>全部正式队伍</span><strong>{problem.participants ? `${(100 * problem.solved / problem.participants).toFixed(1)}%` : '—'}</strong></div><div class="cohort-track overall"><span style={`width:${100 * problem.solved / Math.max(problem.participants, 1)}%`}/></div><span class="cohort-count">{problem.participants ? `${problem.solved} / ${problem.participants} 队通过` : '暂无正式队伍'}</span></div>
        {(['bronze','silver','gold'] as const).map((medal,i) => {const stat = problem.cohorts[medal];return <div class="cohort-row"><div class="cohort-label"><span>{['铜牌','银牌','金牌'][i]}组</span><strong>{stat.rate === null ? '—' : `${(stat.rate*100).toFixed(1)}%`}</strong></div><div class={`cohort-track ${medal}`}><span style={`width:${(stat.rate ?? 0)*100}%`}/></div><span class="cohort-count">{stat.total ? `${stat.solved} / ${stat.total} 队通过` : '该组暂无队伍'}</span></div>})}
      </section>
      <section class="detail-card"><h2>本场记录</h2><dl class="detail-dl"><div><dt>正式队伍通过</dt><dd>{problem.solved} / {problem.participants}</dd></div><div><dt>比赛日期</dt><dd>{contest.date.slice(0,10)}</dd></div><div><dt>数据更新</dt><dd>{contest.syncedAt.slice(0,10)}</dd></div></dl></section>
      <section class="detail-card"><h2>相关链接</h2><a class="detail-external" href={`https://qoj.ac/problem/${problem.qojId}`} target="_blank" rel="noopener noreferrer"><span>QOJ #{problem.qojId}</span><span>↗</span></a><a class="detail-external" href={contest.boardUrl} target="_blank" rel="noopener noreferrer"><span>XCPCIO 比赛榜单</span><span>↗</span></a><a class="detail-external" href={contest.sourceUrl} target="_blank" rel="noopener noreferrer"><span>榜单来源与版本</span><span>↗</span></a></section>
    </aside>
  </div>
</Layout>
<script>
  document.querySelectorAll<HTMLPreElement>('.statement-prose pre').forEach(pre => {
    const code = pre.querySelector('code') ?? pre;
    const block = document.createElement('div');
    block.className = 'statement-code-block';
    const copyButton = document.createElement('button');
    copyButton.type = 'button';
    copyButton.className = 'statement-copy-button';
    const status = document.createElement('span');
    status.className = 'sr-only';
    status.setAttribute('role', 'status');
    const icons = {
      copy: '<rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>',
      success: '<path d="m5 12 4 4L19 6"/>',
      error: '<path d="m6 6 12 12M6 18 18 6"/>',
    };
    function showCopyState(state: keyof typeof icons, message: string) {
      copyButton.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons[state]}</svg>`;
      copyButton.title = message;
      copyButton.setAttribute('aria-label', message);
      status.textContent = state === 'copy' ? '' : message;
    }
    showCopyState('copy', '复制代码块');
    let resetTimer: ReturnType<typeof setTimeout>;
    copyButton.addEventListener('click', async () => {
      clearTimeout(resetTimer);
      copyButton.disabled = true;
      let feedbackDuration = 800;
      try {
        await navigator.clipboard.writeText(code.textContent ?? '');
        showCopyState('success', '已复制');
      } catch {
        showCopyState('error', '复制失败，请手动选择');
        feedbackDuration = 2500;
      } finally {
        copyButton.disabled = false;
        resetTimer = setTimeout(() => { showCopyState('copy', '复制代码块'); }, feedbackDuration);
      }
    });
    pre.before(block);
    block.append(pre, copyButton, status);
  });

  const button = document.querySelector<HTMLButtonElement>('[data-progress-id]');
  const label = button?.querySelector<HTMLElement>('[data-progress-label]');
  const note = document.querySelector<HTMLElement>('[data-progress-note]');
  const storageKey = 'xcpc-problems:solved:v1';
  let saved: string[] = [];
  try { const value = JSON.parse(localStorage.getItem(storageKey) ?? '[]'); if (Array.isArray(value)) saved = value.filter(id => typeof id === 'string'); } catch {}
  function paint() {
    if (button && label) {
      const done = saved.includes(button.dataset.progressId!);
      label.textContent = done ? '已完成' : '标记为已完成';
      button.setAttribute('aria-pressed', String(done));
      button.title = done ? '取消完成标记' : '标记为已完成';
    }
  }
  paint();
  button?.addEventListener('click', () => { const id = button.dataset.progressId!; saved = saved.includes(id) ? saved.filter(item => item !== id) : [...saved, id]; paint(); try { localStorage.setItem(storageKey, JSON.stringify(saved)); } catch { if (note) { note.hidden = false; note.textContent = '浏览器无法保存，本次标记仍有效'; } } });
</script>
