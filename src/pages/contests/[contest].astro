---
import Layout from '../../layouts/Layout.astro';
import ContestLogo from '../../components/ContestLogo.astro';
import { catalog, CONTESTS_PER_PAGE } from '../../lib/catalog';
import { href, problemHref } from '../../lib/urls';
import { difficultyLabels } from '../../lib/schema';
export function getStaticPaths() {
  return catalog.contests.map((contest, index) => ({
    params: { contest: contest.id },
    props: { contest, listPage: Math.floor(index / CONTESTS_PER_PAGE) + 1 },
  }));
}
const { contest, listPage } = Astro.props;
const problems = catalog.problems.filter(p => p.contestId === contest.id);
---
<Layout title={`${contest.shortName} · XCPC 题单`} active="contests">
  <a class="contest-back" href={href(listPage === 1 ? 'contests' : `contests/page/${listPage}`)}><span aria-hidden="true">←</span> 所有比赛</a>
  <header class="contest-header">
    <div class="contest-heading">
      <ContestLogo series={contest.series} />
      <h1>{contest.name}</h1>
      {contest.medalBasis === 'preset' && <div class="contest-estimate">
        <button type="button" class="contest-estimate-icon" aria-label="查看奖牌分组估算说明" aria-describedby="contest-estimate-note">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7h.01"/></svg>
        </button>
        <div class="contest-estimate-popover" id="contest-estimate-note">
          <div class="contest-estimate-card">
            <p>奖牌分组为估算。</p>
            <p>具体可查看<a href={href('methodology')}>分级说明</a>。</p>
          </div>
        </div>
      </div>}
    </div>
    <div class="contest-header-meta">
      <time datetime={contest.date}>{contest.date.slice(0,10)}</time>
      <span>{contest.participants} 支正式队伍</span>
    </div>
    <nav class="contest-resources" aria-label="比赛资源">
      <a href={contest.qojUrl} target="_blank" rel="noopener noreferrer">QOJ 比赛 <span aria-hidden="true">↗</span></a>
      <a href={contest.boardUrl} target="_blank" rel="noopener noreferrer">XCPCIO 榜单 <span aria-hidden="true">↗</span></a>
      {contest.statement && <a href={contest.statement.url} target="_blank" rel="noopener noreferrer">{contest.statement.provenance === 'official' ? '官方' : ''}{contest.statement.language === 'zh' ? '中文' : '英文'}题册 <span aria-hidden="true">↗</span></a>}
    </nav>
  </header>
  <section class="table-card contest-problems" aria-label="比赛题目">
    <div class="table-scroll">
      <table class="problem-table">
        <caption class="sr-only">{contest.name}题目列表</caption>
        <thead><tr><th scope="col">题目</th><th scope="col">难度</th><th scope="col" class="rate-column">通过队伍</th><th scope="col" class="links-column">提交</th></tr></thead>
        <tbody>{problems.map(p => <tr data-problem-id={p.id}>
          <td>
            <a class="problem-title" href={problemHref(p.id)} target="_blank" rel="noopener noreferrer"><span class="problem-letter">{p.label}</span><span>{p.title}</span>{p.interactive && <span class="contest-problem-note">交互题</span>}<span class="contest-completion" hidden><span aria-hidden="true">✓</span> 已完成</span></a>
          </td>
          <td><span class={`difficulty-badge ${p.difficulty}`}>{difficultyLabels[p.difficulty]}</span></td>
          <td class="rate-column"><span class="solve-count"><strong>{p.solved}</strong></span></td>
          <td class="links-column"><div class="row-links"><a href={`https://qoj.ac/problem/${p.qojId}`} target="_blank" rel="noopener noreferrer" aria-label={`在 QOJ 提交 ${p.label} 题`}>QOJ <span aria-hidden="true">↗</span></a></div></td>
        </tr>)}</tbody>
      </table>
    </div>
  </section>
</Layout>

<script>
  import { readSolvedProgress, SOLVED_STORAGE_KEY } from '../../lib/progress';

  const estimate = document.querySelector<HTMLElement>('.contest-estimate');
  const popover = estimate?.querySelector<HTMLElement>('.contest-estimate-popover');
  if (estimate && popover) {
    const positionPopover = () => {
      const anchor = estimate.getBoundingClientRect();
      const width = popover.offsetWidth;
      const centeredLeft = anchor.left + anchor.width / 2 - width / 2;
      const left = Math.max(16, Math.min(centeredLeft, document.documentElement.clientWidth - width - 16));
      popover.style.left = `${left - anchor.left}px`;
    };
    estimate.addEventListener('pointerenter', positionPopover);
    estimate.addEventListener('focusin', positionPopover);
    window.addEventListener('resize', positionPopover);
  }

  const rows = document.querySelectorAll<HTMLTableRowElement>('.contest-problems tr[data-problem-id]');
  const refreshProgress = () => {
    const solved = readSolvedProgress();
    for (const row of rows) {
      const completed = solved.has(row.dataset.problemId!);
      row.classList.toggle('is-solved', completed);
      const indicator = row.querySelector<HTMLElement>('.contest-completion');
      if (indicator) indicator.hidden = !completed;
    }
  };

  refreshProgress();
  window.addEventListener('pageshow', refreshProgress);
  window.addEventListener('focus', refreshProgress);
  window.addEventListener('storage', event => {
    if (event.key === SOLVED_STORAGE_KEY || event.key === null) refreshProgress();
  });
</script>
