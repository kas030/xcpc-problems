---
import Layout from '../../layouts/Layout.astro';
import { catalog } from '../../lib/catalog';
import { href, problemHref } from '../../lib/urls';
import { difficultyLabels } from '../../lib/schema';
export function getStaticPaths() { return catalog.contests.map(contest => ({ params: { contest: contest.id }, props: { contest } })); }
const { contest } = Astro.props;
const problems = catalog.problems.filter(p => p.contestId === contest.id);
---
<Layout title={`${contest.shortName} · XCPC 题单`} active="contests">
  <nav class="breadcrumb" aria-label="面包屑"><a href={href()}>题单</a><span>/</span><a href={href('contests')}>比赛</a><span>/</span><span>{contest.shortName}</span></nav>
  <div class="section-heading"><div class="section-kicker">{contest.series} / REGIONAL CONTEST</div><h1>{contest.name}</h1><p>{contest.date.slice(0,10)} · {contest.participants} 支正式队伍 · {contest.problemCount} 道题</p><div class="contest-actions"><a class="button button-primary" href={`${href()}?contest=${contest.id}`}>在题单中筛选 →</a><a class="button" href={contest.qojUrl} target="_blank" rel="noopener noreferrer">QOJ 比赛 ↗</a><a class="button" href={contest.boardUrl} target="_blank" rel="noopener noreferrer">XCPCIO 榜单 ↗</a>{contest.statement && <a class="button" href={contest.statement.url} target="_blank" rel="noopener noreferrer">官方中文题册 ↗</a>}</div></div>
  <div class="contest-summary">{(['gold','silver','bronze'] as const).map((medal,i) => <div class="summary-chip"><strong>{contest.medalCounts[medal]}</strong>{['金牌','银牌','铜牌'][i]}组队伍</div>)}<div class="summary-chip"><strong>50%</strong>分级通过率阈值</div></div>
  <p class="detail-note">{contest.classificationNote} · {contest.medalSource ? <a href={contest.medalSource} target="_blank" rel="noopener noreferrer">奖牌人数来源 ↗</a> : <a href={href('methodology')}>查看比例分组规则 →</a>}</p>
  <div class="table-card static-table"><table class="problem-table"><thead><tr><th>题目</th><th>难度</th><th class="rate-column">正式队伍通过</th><th class="links-column">提交</th></tr></thead><tbody>{problems.map(p => <tr><td><a class="problem-title" href={problemHref(p.id)}><span class="problem-letter">{p.label}</span><span>{p.title}</span></a><div class="problem-subline">QOJ #{p.qojId} · 官方中文 PDF{p.interactive ? ' · 交互题' : ''}</div></td><td><a href={`${problemHref(p.id)}#difficulty`} class={`difficulty-badge ${p.difficulty}`}><span class="badge-dot" />{difficultyLabels[p.difficulty]}</a></td><td class="rate-column"><span class="solve-count"><strong>{p.solved}</strong><span> / {p.participants}</span></span></td><td class="links-column"><div class="row-links"><a href={`https://qoj.ac/problem/${p.qojId}`} target="_blank" rel="noopener noreferrer">QOJ ↗</a></div></td></tr>)}</tbody></table></div>
  <p class="detail-note">数据同步于 {contest.syncedAt.slice(0,10)} · <a href={contest.sourceUrl} target="_blank" rel="noopener noreferrer">查看来源快照 {contest.sourceRevision.slice(0,7)} ↗</a></p>
</Layout>
