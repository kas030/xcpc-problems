---
import Layout from '../../layouts/Layout.astro';
import { catalog } from '../../lib/catalog';
import { href, problemHref } from '../../lib/urls';
import { difficultyLabels } from '../../lib/schema';
export function getStaticPaths() { return catalog.contests.map(contest => ({ params: { contest: contest.id }, props: { contest } })); }
const { contest } = Astro.props;
const problems = catalog.problems.filter(p => p.contestId === contest.id);
---
<Layout title={`${contest.shortName} · XCPC 题单`} active="contests">
  <a class="contest-back" href={href('contests')}><span aria-hidden="true">←</span> 所有比赛</a>
  <header class="contest-header">
    <h1>{contest.name}</h1>
    <div class="contest-header-meta">
      <time datetime={contest.date}>{contest.date.slice(0,10)}</time>
      <span>{contest.participants} 支正式队伍</span>
    </div>
    <nav class="contest-resources" aria-label="比赛资源">
      <a href={contest.qojUrl} target="_blank" rel="noopener noreferrer">QOJ 比赛 <span aria-hidden="true">↗</span></a>
      <a href={contest.boardUrl} target="_blank" rel="noopener noreferrer">XCPCIO 榜单 <span aria-hidden="true">↗</span></a>
      {contest.statement && <a href={contest.statement.url} target="_blank" rel="noopener noreferrer">{contest.statement.provenance === 'official' ? '官方' : ''}{contest.statement.language === 'zh' ? '中文' : '英文'}题册 <span aria-hidden="true">↗</span></a>}
    </nav>
  </header>
  <section class="table-card contest-problems" aria-label="比赛题目">
    <div class="table-scroll">
      <table class="problem-table">
        <caption class="sr-only">{contest.name}题目列表</caption>
        <thead><tr><th scope="col">题目</th><th scope="col">难度</th><th scope="col" class="rate-column">通过队伍</th><th scope="col" class="links-column">提交</th></tr></thead>
        <tbody>{problems.map(p => <tr>
          <td>
            <a class="problem-title" href={problemHref(p.id)}><span class="problem-letter">{p.label}</span><span>{p.title}</span>{p.interactive && <span class="contest-problem-note">交互题</span>}</a>
          </td>
          <td><span class={`difficulty-badge ${p.difficulty}`}><span class="badge-dot" />{difficultyLabels[p.difficulty]}</span></td>
          <td class="rate-column"><span class="solve-count"><strong>{p.solved}</strong></span></td>
          <td class="links-column"><div class="row-links"><a href={`https://qoj.ac/problem/${p.qojId}`} target="_blank" rel="noopener noreferrer" aria-label={`在 QOJ 提交 ${p.label} 题`}>QOJ <span aria-hidden="true">↗</span></a></div></td>
        </tr>)}</tbody>
      </table>
    </div>
  </section>
</Layout>
