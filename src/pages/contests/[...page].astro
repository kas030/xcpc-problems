---
import type { GetStaticPaths } from 'astro';
import { ChevronLeft, ChevronRight } from 'lucide-react';
import Layout from '../../layouts/Layout.astro';
import ContestLogo from '../../components/ContestLogo.astro';
import { catalog, CONTESTS_PER_PAGE } from '../../lib/catalog';
import { href } from '../../lib/urls';

export const getStaticPaths = (() => {
  const pageSize = CONTESTS_PER_PAGE;
  const total = catalog.contests.length;
  const totalPages = Math.max(1, Math.ceil(total / pageSize));
  return Array.from({ length: totalPages }, (_, index) => ({
    params: { page: index === 0 ? undefined : `page/${index + 1}` },
    props: {
      contests: catalog.contests.slice(index * pageSize, (index + 1) * pageSize),
      currentPage: index + 1,
      totalPages,
      total,
      start: index * pageSize,
    },
  }));
}) satisfies GetStaticPaths;

const { contests, currentPage, totalPages, total, start } = Astro.props;
const pageHref = (page: number) => href(page === 1 ? 'contests' : `contests/page/${page}`);
const pageNumbers = Array.from({ length: totalPages }, (_, index) => index + 1)
  .filter(page => totalPages <= 7 || page === 1 || page === totalPages || Math.abs(page - currentPage) <= 1);
---
<Layout title={`${currentPage === 1 ? '比赛目录' : `比赛目录 · 第 ${currentPage} 页`} · XCPC 题单`} active="contests">
  <h1 class="sr-only">比赛目录{currentPage > 1 && ` · 第 ${currentPage} 页`}</h1>
  <div class="contest-grid">{contests.map(c => <a class="contest-card" href={href(`contests/${c.id}`)} aria-label={`查看${c.shortName}比赛题单`}>
    <div class="contest-card-logo"><ContestLogo series={c.series} /></div>
    <div class="contest-card-heading">
      <h2>{c.shortName}</h2>
    </div>
    <svg class="contest-card-arrow" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
    <div class="contest-card-meta">
      <time datetime={c.date}>{new Date(c.date).toLocaleDateString('zh-CN', { timeZone: 'Asia/Shanghai', year:'numeric', month:'2-digit', day:'2-digit' })}</time>
      <span aria-hidden="true">·</span>
      <span>{c.problemCount} 道题</span>
    </div>
  </a>)}</div>
  <nav class="pagination contest-pagination" aria-label="比赛分页">
    <span>{total ? `${start + 1}–${start + contests.length}` : '0'} / {total} 场比赛</span>
    {totalPages > 1 && <div>
      {currentPage > 1 ? <a class="icon-button" href={pageHref(currentPage - 1)} rel="prev" aria-label="上一页"><ChevronLeft size={17} aria-hidden="true" /></a> : <span class="icon-button" aria-label="上一页" aria-disabled="true"><ChevronLeft size={17} aria-hidden="true" /></span>}
      {pageNumbers.map((page, index) => <>
        {index > 0 && pageNumbers[index - 1] !== page - 1 && <span class="page-ellipsis" aria-hidden="true">…</span>}
        <a class:list={['page-number', { current: page === currentPage }]} href={pageHref(page)} aria-label={`第 ${page} 页`} aria-current={page === currentPage ? 'page' : undefined}>{page}</a>
      </>)}
      {currentPage < totalPages ? <a class="icon-button" href={pageHref(currentPage + 1)} rel="next" aria-label="下一页"><ChevronRight size={17} aria-hidden="true" /></a> : <span class="icon-button" aria-label="下一页" aria-disabled="true"><ChevronRight size={17} aria-hidden="true" /></span>}
    </div>}
  </nav>
</Layout>
