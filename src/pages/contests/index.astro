---
import Layout from '../../layouts/Layout.astro';
import { catalog } from '../../lib/catalog';
import { href } from '../../lib/urls';
---
<Layout title="比赛目录 · XCPC 题单" active="contests">
  <div class="contest-grid">{catalog.contests.map(c => <a class="contest-card" href={href(`contests/${c.id}`)} aria-label={`查看${c.shortName}比赛题单`}>
    <div class="contest-card-heading">
      <h2>{c.shortName}</h2>
      <svg class="contest-card-arrow" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
    </div>
    <div class="contest-card-meta">
      <time datetime={c.date}>{new Date(c.date).toLocaleDateString('zh-CN', { timeZone: 'Asia/Shanghai', year:'numeric', month:'2-digit', day:'2-digit' })}</time>
      <span aria-hidden="true">·</span>
      <span>{c.problemCount} 道题</span>
    </div>
  </a>)}</div>
</Layout>
