---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { catalog } from '../lib/catalog';
import { base, href } from '../lib/urls';
interface Props { title?: string; description?: string; active?: 'problems' | 'contests' | 'training' | 'methodology'; wide?: boolean }
const { title = 'XCPC 题单 · 找到下一道值得做的题', description = '基于真实 XCPC 榜单的训练题单，按金银铜牌队伍通过率筛选，直达中文题面、QOJ 与比赛榜单。', active = 'problems', wide = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f5f9" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}/favicon-16.png`} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳至主要内容</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={href()} aria-label="XCPC 题单首页">
          <img class="brand-mark" src={`${base}/logo.png`} width="40" height="40" alt="" />
          <span>XCPC<span class="brand-zh">题单</span></span>
        </a>
        <nav class="main-nav" aria-label="主导航">
          <a href={href()} class:list={{ active: active === 'problems' }} aria-current={active === 'problems' ? 'page' : undefined}>题目</a>
          <a href={href('contests')} class:list={{ active: active === 'contests' }} aria-current={active === 'contests' ? 'page' : undefined}>比赛</a>
          <a href={href('training')} class:list={{ active: active === 'training' }} aria-current={active === 'training' ? 'page' : undefined}>训练情况</a>
          <a href={href('methodology')} class:list={{ active: active === 'methodology' }} aria-current={active === 'methodology' ? 'page' : undefined}>分级说明</a>
        </nav>
        <a class="github-link" href="https://github.com/kas030/xcpc-problems" target="_blank" rel="noopener noreferrer" aria-label="在 GitHub 查看源码">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65"><path d="M9 19c-4.3 1.3-4.3-2-6-2m12 5v-3.4a3 3 0 0 0-.8-2.3c2.7-.3 5.6-1.3 5.6-6a4.7 4.7 0 0 0-1.3-3.3 4.3 4.3 0 0 0-.1-3.3s-1.1-.3-3.4 1.3a11.4 11.4 0 0 0-6 0C6.7 2.4 5.6 2.7 5.6 2.7a4.3 4.3 0 0 0-.1 3.3A4.7 4.7 0 0 0 4.2 9.3c0 4.7 2.9 5.7 5.6 6a3 3 0 0 0-.8 2.3V22"/></svg>
          <span>GitHub</span><span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>
    <main id="main" class:list={['page-shell', { 'page-wide': wide }]}><slot /></main>
    <footer class="site-footer"><div><span>榜单数据来自 <a href="https://board.xcpcio.com/" target="_blank" rel="noopener noreferrer">XCPCIO ↗</a></span><span class="footer-divider">/</span><span>数据更新于 {catalog.updatedAt.slice(0,10)}</span></div></footer>
  </body>
</html>
